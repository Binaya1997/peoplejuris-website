digraph G {
 graph [fontname="DejaVu Sans", fontsize=11, bgcolor="white", pad="0.30", nodesep="0.52", ranksep="0.72", splines=ortho, labelloc="t", labeljust="l", fontcolor="#16243A"];
 node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#59708B", fillcolor="#F3F6FA", fontcolor="#172B45", penwidth=1.25, margin="0.17,0.12"];
