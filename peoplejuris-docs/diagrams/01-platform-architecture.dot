 browser -> cfzone [label="DNS lookup / HTTPS site request"];
 siteworker -> browser [label="website response\nstatic/frontend content"];
 browser -> render [label="HTTPS API calls\npublic + admin endpoints", color="#2878B5", fontcolor="#1D5E91"];
