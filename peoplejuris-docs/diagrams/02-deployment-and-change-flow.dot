digraph G {
 graph [fontname="DejaVu Sans", fontsize=11, bgcolor="white", pad="0.28", nodesep="0.45", ranksep="0.62", splines=ortho, labelloc="t", labeljust="l", fontcolor="#16243A"];
 node [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", color="#59708B", fillcolor="#F3F6FA", fontcolor="#172B45", penwidth=1.25, margin="0.17,0.12"];
 edge [fontname="DejaVu Sans", fontsize=9, color="#52657A", fontcolor="#334155", penwidth=1.25, arrowsize=0.75];
 label="PEOPLEJURIS — SOURCE CHANGE & RELEASE FLOW\nCloudflare dashboard shows website Worker linked to GitHub; other deployment triggers remain unverified";
 rankdir=TB;
 dev [label="Developer workstation\nedit • test • review", fillcolor="#EAF4FF"];
 branch [label="Git branch\nfeature / fix / docs", fillcolor="#EAF4FF"];
 pr [label="Pull request / review\ninspect diff • validate", fillcolor="#EAF4FF"];
 merge [label="Merge / approved commit\nGitHub repository", fillcolor="#F4F4F5"];
 dev -> branch [label="commit"];
 branch -> pr [label="push / open PR"];
 pr -> merge [label="approve + merge"];
 subgraph cluster_targets { label="CURRENT SERVICE TARGETS"; color="#C9D5E3"; style="rounded";
   site [label="Cloudflare Worker\npeoplejuris-website\nGitHub repository shown as connected\ncustom domain: peoplejuris.com", fillcolor="#FFF4E5"];
   render [label="Render Python backend\npeoplejuris-feature-api.onrender.com\nowner-confirmed service", fillcolor="#F1ECFF"];
   api [label="Cloudflare Worker API\npeoplejuris-db-api\nseparate D1 gateway", fillcolor="#FFF4E5"];
   d1 [label="Cloudflare D1\npeoplejuris-d1", shape=cylinder, fillcolor="#EAF7EF"];
   render -> api [label="server-to-server API"];
   api -> d1 [label="DB binding"];
 }
 merge -> site [style=dashed, label="repository connection visible\ntrigger/build settings must be checked", color="#A36A16", fontcolor="#8B5A12"];
 merge -> render [style=dashed, label="deployment integration / branch\nnot evidenced by Cloudflare screenshots", color="#A36A16", fontcolor="#8B5A12"];
 merge -> api [style=dashed, label="Worker API source/deploy path\nnot shown in supplied screenshots", color="#A36A16", fontcolor="#8B5A12"];
 smoke [label="Post-release checks\nsite • public API • admin login\nnewsletter list / upload / download", fillcolor="#EAF7EF"];
 site -> smoke [label="verify"];
 render -> smoke [label="verify"];
 api -> smoke [label="verify"];
 smoke -> rollback [label="if a regression is confirmed"];
 rollback [label="Rollback only the affected service\nWorker / Render release history\nD1 restore requires a tested backup", fillcolor="#FFF1F0", color="#B65C58"];
 caution [shape=note, label="Do not describe this as a Pages deployment. The dashboard lists peoplejuris-website and peoplejuris-db-api under Workers & Pages; the opened details identify both as Workers. No GitHub Actions workflow was present in the supplied application ZIP. The linked repo does not by itself prove exact CI trigger rules.", fillcolor="#FFFBEA", color="#C49A3A", fontsize=9];
 {rank=sink; caution;}
 merge -> caution [style=dotted, arrowhead=none];
}
